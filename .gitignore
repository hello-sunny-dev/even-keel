# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Real bank statements — never committed, even in a private repo.
# The folder is kept so the local-only fixture tests have somewhere to look.
/test-fixtures/real/*
!/test-fixtures/real/.gitkeep

# Anywhere else real statements plausibly get dropped. `npm run dump -- finance`
# reads them from here quite happily; git never should, and `git add -A` is one
# keystroke away from a private repo full of somebody's bank account.
/finance/
/statements/
*.pdf
!/test-fixtures/sample/*.pdf
# Any local PGlite database, whatever it is called. A smoke test of a
# production build uses its own directory, and one of these is 39MB of
# somebody's real figures.
.pglite*/

# Playwright: traces and screenshots of failures, and the cookies the suite
# signs itself in with. All rebuilt on every run.
/test-results/
/playwright-report/
/e2e/.auth/
